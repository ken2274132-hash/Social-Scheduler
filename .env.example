# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta App Configuration (Facebook/Instagram)
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
NEXT_PUBLIC_META_APP_ID=your-app-id

# AI Provider (Choose one)
OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GOOGLE_AI_API_KEY=your-google-ai-key

# App Configuration
# For local development use http://localhost:3000
# For production use your Vercel URL: https://social-media-scheduler-auto-repurpo.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Shopify Configuration
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_SCOPES=read_products

# Pinterest Configuration
PINTEREST_APP_ID=your-pinterest-app-id
PINTEREST_APP_SECRET=your-pinterest-app-secret
# Optional. Defaults to https://api.pinterest.com, which is what Trial access
# apps use. Only set this to https://api-sandbox.pinterest.com if you are
# deliberately working against Pinterest's sandbox — it applies to the token
# exchange, the refresh and publishing together, and mixing the two hosts
# makes every publish fail with a misleading auth error.
# PINTEREST_API_BASE_URL=

# Local development only: set to true to skip the login screen.
# Has no effect in a deployed build (NODE_ENV is always "production" there).
DEV_BYPASS_AUTH=false
DEV_BYPASS_USER_ID=

# Sentry Error Monitoring (entirely optional)
# Leave every value below empty to disable Sentry: no SDK init, no network
# calls, and next.config.ts is not even wrapped. Setting the DSN turns it on.
#
# Both DSNs are the same value from Sentry > Settings > Projects > Client Keys.
# NEXT_PUBLIC_ is needed for browser errors; the unprefixed one is used by the
# Node and Edge runtimes.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-time only, for uploading source maps (readable stack traces).
# Omit the auth token and the build simply skips the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional tuning. Defaults to 0.1 (10% of traces) to stay inside the free tier.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Overrides the environment label (defaults to VERCEL_ENV, then NODE_ENV).
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
