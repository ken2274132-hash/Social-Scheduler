{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "social-scheduler",
    // Custom entry point: re-exports the adapter's fetch handler and adds the
    // scheduled handler that drives the publish cron. See worker.ts.
    "main": "worker.ts",
    "compatibility_date": "2025-09-23",
    // Required by the adapter — the app uses node:crypto and Buffer.
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    // Replaces the Vercel Cron entry in vercel.json. Same every-5-minutes
    // schedule the scheduler has always run on.
    "triggers": {
        "crons": ["*/5 * * * *"]
    },
    // Free, and the only way to read console.error from the cron after the fact.
    "observability": {
        "enabled": true
    }
}
